{
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30
        }
    },
    "outputDirectory": "public",
    "routes": [
        { "src": "/build/(.*)", "dest": "/build/$1" },
        { "src": "/(favicon\\.ico|robots\\.txt|.*\\.svg|.*\\.png|.*\\.jpg|.*\\.html)", "dest": "/$1" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ]
}
